# Inject actual secrets through the deployment secret store, never commit them.
DATABASE_URL=postgresql://runtime_user:REPLACE@localhost:5432/manager?sslmode=verify-full
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
OWNER_USER_IDS=REPLACE_WITH_AUTH_USER_UUID
ALLOWED_ORIGINS=https://manager.trillionaitech.com
INGRESS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=8080
# Separate keys and signing secrets per product account. Prefer restricted keys.
STRIPE_ACCOUNTS=[]
# [{"id":"website","key":"<secret-store>","webhookSecret":"<secret-store>","ownerEmails":["anselm.perkins@gmail.com"]}]
BRIDGES={}
# {"marketing":{"url":"https://YOUR_CONTROLLED_ADAPTER","token":"<secret-store>","operations":["acquire"]}}
SOURCES=[]
# [{"kind":"marketing","url":"https://YOUR_MARKETING_API","token":"<machine credential>"},{"kind":"github","url":"https://api.github.com","repository":"Anselm04/AppForge.","token":"<read-only credential>"},{"kind":"website","url":"https://trillionaitech.com"}]
